[Unit]
Description=soundtube - generation de musique instrumentale par algorithme
Documentation=file:///opt/soundtube/app/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=soundtube
Group=soundtube
WorkingDirectory=/opt/soundtube/app
EnvironmentFile=/etc/soundtube/soundtube.env
Environment=NODE_ENV=production
ExecStart=@NODE@ /opt/soundtube/app/src/server.js
Restart=on-failure
RestartSec=3
# Le rendu audio est gourmand en CPU : priorité légèrement abaissée
Nice=5
LimitNOFILE=65536

# Durcissement (compatible conteneur LXC non privilégié avec nesting=1)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/soundtube

[Install]
WantedBy=multi-user.target
