# Configuration de soundtube (relue au redémarrage : systemctl restart soundtube)

# Adresse et port d'écoute
SOUNDTUBE_HOST=0.0.0.0
SOUNDTUBE_PORT=8080

# Dossier des données (base SQLite + fichiers audio)
SOUNDTUBE_DATA_DIR=/var/lib/soundtube

# Nombre de générations simultanées (1 par cœur CPU conseillé)
SOUNDTUBE_MAX_JOBS=2
# Taille max de la file d'attente
SOUNDTUBE_MAX_QUEUE=50
# Durée max d'un morceau (secondes, 14400 = 4 h max)
SOUNDTUBE_MAX_DURATION=14400

# Export MP3 via ffmpeg : auto | on | off
SOUNDTUBE_MP3=auto
SOUNDTUBE_MP3_BITRATE=320k
# Mastering YouTube : loudness intégrée cible (LUFS) et plafond true-peak (dBTP)
SOUNDTUBE_LUFS=-14
SOUNDTUBE_TRUE_PEAK=-1
# Artiste inscrit dans les balises ID3 / WAV
SOUNDTUBE_ARTIST=soundtube
# Conserver le WAV (true/false) : WAV produit par défaut, désactivable par morceau (option wav=false)
SOUNDTUBE_KEEP_WAV=true

# Banque d'échantillons CC0 (instruments acoustiques) et cache mémoire des échantillons décodés (Mo)
#SOUNDTUBE_SAMPLES=/opt/soundtube/assets/samples
SOUNDTUBE_SAMPLE_CACHE_MB=160

# Taille max d'une animation de fond importée dans le panneau YouTube (Mo)
SOUNDTUBE_MEDIA_MAX_MB=500

# v1.7.0 — rendu vidéo réparti sur le réseau local (page Admin). Les nœuds se gèrent dans l'interface ;
# cette liste ne sert qu'au premier démarrage (séparateur : virgule), ex. le PC Windows RTX :
#SOUNDTUBE_RENDER_NODES=http://192.168.1.50:8765
# Jeton partagé optionnel (le même que « token » dans config.json de l'agent ; vide = sans jeton)
#SOUNDTUBE_NODE_TOKEN=
# Rendus vidéo simultanés sur le CT (secours ou mode parallèle)
#SOUNDTUBE_LOCAL_VIDEO_SLOTS=1
